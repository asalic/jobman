{
    "jobsQueue": {
        "namespace": "default",
        "configmap": "jobman-queue-position",
        "gpuResources": [ ]
    },
    "job": {
        "serviceAccount": "jobman-k8s-logger-serviceaccount",
        "serviceAccountTokenSecret": "jobman-k8s-logger-serviceaccount-secret",
        "kubeRootCASecret": "kube-root-ca.crt",
        "userNameAnnotation": "username",
        "protectedNamespace": "jobman-exec",
        "annotations": null,
        "defaultImage": {
            "fullUrl": null,
            "imagePullSecrets": []
        },
        "imagePrefix": null,
        "userConfigmap": null,
        "priorityClassName": null,
        "securityContext": {
            "runAsUser": 0,
            "runAsGroup": 0,
            "fsGroup": 0,
            "supplementalGroups": []
        },
        "resources": {
            "default": null,
            "label": null,
            "predefined": []
        },
        "k8sLogger": {
            "image": "<docker-url-lib>/jobman-k8s-logger:latest",
            "sleep": 15
        }
    },
    "kubeConfig": {
        "type": "file",
        "file": "/kube_config.json"
    },
    "harborProjects": [
            {
                "name": "chaimeleon-library-batch",
                "token": null,
                "baseUrl": "https://<docker-url-lib>",
                "imagePullSecrets": [
                    {
                        "name": "<secret_name>"
                    }
                ]
            }
        ],
    "oidc": {
        "apiTokenAttributeName": "",
        "url": "",
        "realm": "CHAIMELEON",
        "clientId": "jobman-service",
        "clientSecret": "",
        "audiences": [
            "jobman-service"
        ],
        "resourceAccessRoles": [
            "manage-own-jobs"
        ]
    },
    "port": 9000,
    "path": {
        "prefix": "",
        "api": "/api/v1"
    },
    "defaultKubeURL": "",
    "log": {
        "directory": "/var/log/jobman",
        "level": "info",
        "fileName": "jobman-webservice.log"
    }
}