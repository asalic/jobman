{
  "name": "jobman",
  "version": "2.3.1",
  "main": "./dist/index.ts",
  "exports": {
    "default": "./src/"
  },
  "bin": {
    "jobman": "./bin/jobman",
    "jobman-webservice": "./bin/jobman-webservice",
    "jobman-k8s-logger": "./bin/jobman-k8s-logger"
  },
  "description": "The Kubernetes job manager",
  "dependencies": {
    "swagger-ui-express": "5.0.1",
    "swagger-jsdoc": "6.3.0",
    "@kubernetes/client-node": "1.4.0",
    "console-table-printer": "2.16.1",
    "deepmerge": "4.3.1",
    "loglevel": "1.9.2",
    "marked-terminal": "7.3.0",
    "tar-stream": "3.2.0",
    "uuid": "14.0.1",
    "express": "5.2.1",
    "http-errors": "2.0.1",
    "http-proxy-middleware": "4.2.0",
    "compare-versions": "6.1.1",
    "jose": "6.2.3",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "pino-pretty": "13.1.3"
  },
  "scripts": {
    "start": "ts-node-esm src/client/index.ts",
    "prod": "node dist/client/index.js",
    "dev": "nodemon --exec 'npm start'",
    "start-webservice": "ts-node-esm src/webservice/index.ts",
    "prod-webservice": "node dist/webservice/index.js",
    "prod-k8s-logger": "node dist/k8s-logger/index.js",
    "dev-webservice": "nodemon --watch src --ext ts,js,json --exec \"node --loader ts-node/esm src/webservice/index.ts\" --",
    "test": "NODE_OPTIONS=--experimental-vm-modules npx jest",
    "build": "node_modules/.bin/tsc && cp usage.md examples.md ./dist/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EUCAIM/jobman.git"
  },
  "author": "Andy S Alic (asalic)",
  "license": "SEE LICENSE IN LICENSE",
  "bugs": {
    "url": "https://github.com/EUCAIM/jobman/issues"
  },
  "homepage": "https://github.com/EUCAIM/jobman#readme",
  "devDependencies": {
    "@types/swagger-ui-express": "4.1.8",
    "@types/swagger-jsdoc": "6.0.4",
    "ts-node": "10.9.2",
    "@jest/globals": "30.4.1",
    "@types/jest": "30.0.0",
    "@types/node": "26.1.0",
    "@types/tar-stream": "3.1.4",
    "@types/express": "5.0.6",
    "jest": "30.4.2",
    "nodemon": "3.1.14",
    "ts-jest": "29.4.11",
    "tslib": "2.8.1",
    "typescript": "6.0.3"
  },
  "type": "module"
}
